rules_version = '2';

// TOLAK SEMUA dari klien — ini disengaja.
//
// Seluruh baca/tulis data di aplikasi ini berjalan lewat Firebase Admin SDK di
// server (lihat lib/firebase-admin.ts), dan Admin SDK MELEWATI aturan ini
// sepenuhnya. Jadi menolak semua akses klien tidak merusak apa pun.
//
// Kalau aturan dibiarkan terbuka (mis. masih mode test), konfigurasi Firebase
// yang bersifat publik di bundel browser cukup untuk membaca seluruh koleksi
// users — email, status akses, IP perangkat — langsung dari DevTools, tanpa
// menyentuh satu baris pun kode server.
//
// Pasang dengan:  firebase deploy --only firestore:rules
// atau tempel isinya di Firebase Console → Firestore → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
